{
  "name": "tabiri-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n CSS,WEB -c cyan,green \"npm:watch:css\" \"npm:serve\"",
    "build": "npm run build:icons && npm run build:css",
    "build:icons": "node scripts/build-icon-font.js",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./assets/css/styles.css --watch",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "4.3.0",
    "concurrently": "^9.2.0",
    "http-server": "^14.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "4.3.0"
  }
}
